# Copiez ce fichier en .env et renseignez les deux valeurs.
# Supabase → Project Settings → API
#
# La clé « anon » est publique par nature : elle est embarquée dans l'application.
# Ce qui protège les données, ce sont les politiques RLS, pas le secret de cette clé.
# Ne mettez JAMAIS la clé « service_role » ici.

EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
